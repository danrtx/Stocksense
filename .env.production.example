# Copia este archivo como .env en el servidor y llena cada valor.
# Nunca lo subas a GitHub (ya está en .gitignore).

# Para que todos los comandos (docker compose, scripts/respaldo.sh…) usen producción.
COMPOSE_FILE=docker-compose.prod.yml

# Dirección pública, sin https:// (por ejemplo, un subdominio gratis de DuckDNS).
DOMAIN=stocksense.duckdns.org
# Correo para Let's Encrypt: avisa si el certificado tiene algún problema.
ACME_EMAIL=tu-correo@ejemplo.com

APP_ENV=production

# Base de datos. Genera la clave con: openssl rand -base64 24
POSTGRES_USER=stocksense
POSTGRES_PASSWORD=
POSTGRES_DB=stocksense

# Genera cada uno con: openssl rand -base64 48
JWT_SECRET=
FORECAST_TOKEN=

SESSION_IDLE_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Primer administrador: se crea al arrancar si no existe. Usa una clave fuerte y cámbiala al entrar.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Correo real para invitaciones, recuperar clave y alertas (ejemplo con Brevo, plan gratis).
# En Brevo: SMTP y API › SMTP. El remitente debe estar verificado en Brevo.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=StockSense <tu-correo-verificado@ejemplo.com>

# Pronóstico y avisos
PIPELINE_DAILY_AT=02:00
TECH_ALERT_EMAILS=

# Gemini (opcional: sin clave la aplicación funciona sin las funciones de IA)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview

# Solo para un servidor de demostración: permite cargar los datos de ejemplo con
# npm run seed:reset. En un negocio real, déjalo en false.
ALLOW_DEMO_SEED=false
