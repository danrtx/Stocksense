# Copia este archivo como .env (desarrollo local sin Docker) y ajusta los valores.
# NUNCA subas tu .env real al repositorio.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://stocksense:stocksense@localhost:5432/stocksense
DB_SSL=false

# Genera uno propio con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-48-caracteres
SESSION_IDLE_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
BCRYPT_COST=12
INVITE_EXPIRATION_HOURS=72

FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Mailpit (docker compose) recibe los correos en http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=StockSense <no-reply@stocksense.local>

# Primer administrador que crea "npm run seed"
ADMIN_EMAIL=admin@stocksense.local
ADMIN_PASSWORD=CambiaEsta2026

# Gemini (sprints 7 y 8). Pon aquí tu clave solo en tu .env local o en el gestor de secretos.
# Sin clave, la app funciona igual y sin las funciones de IA.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
# Tiempo máximo por llamada (con reintentos) y precios por millón de tokens para estimar el costo.
GEMINI_TIMEOUT_MS=10000
GEMINI_PRICE_INPUT_PER_M=2
GEMINI_PRICE_OUTPUT_PER_M=12

# Servicio de pronóstico (carpeta forecast/). Sin FORECAST_URL, el botón "Ejecutar ahora" avisa que no está configurado.
FORECAST_URL=http://localhost:8000
FORECAST_TOKEN=cambia-este-token-interno
