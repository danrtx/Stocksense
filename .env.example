# Copia este archivo como .env antes de correr "docker compose up --build".
# El archivo .env real nunca se sube al repositorio.
APP_ENV=development
POSTGRES_USER=stocksense
POSTGRES_PASSWORD=stocksense
POSTGRES_DB=stocksense

# Genera uno propio con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-48-caracteres
SESSION_IDLE_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Primer administrador
ADMIN_EMAIL=admin@stocksense.local
ADMIN_PASSWORD=CambiaEsta2026

# Clave de Gemini (sprint 7). Déjala vacía hasta entonces.
GEMINI_API_KEY=
