# Copia este archivo como .env antes de correr "docker compose up --build".
# El archivo .env real nunca se sube al repositorio.
APP_ENV=development
POSTGRES_USER=stocksense
POSTGRES_PASSWORD=stocksense
POSTGRES_DB=stocksense

# Puertos en tu equipo. Cámbialos si alguno ya está ocupado.
DB_PORT=5433
API_PORT=3000
WEB_PORT=8080
MAIL_UI_PORT=8025
MAIL_SMTP_PORT=1025

# Genera uno propio con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-48-caracteres
SESSION_IDLE_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Primer administrador
ADMIN_EMAIL=admin@stocksense.local
ADMIN_PASSWORD=CambiaEsta2026

# Servicio de pronóstico (Python). La API y el servicio deben usar el mismo token.
FORECAST_TOKEN=cambia-este-token-interno
# Hora diaria (Bogotá) en que se preparan los datos del modelo. Vacío = solo manual.
PIPELINE_DAILY_AT=02:00

# A quién avisar por correo si falla un reentrenamiento (separados por coma). Vacío = administradores.
TECH_ALERT_EMAILS=

# Gemini (sprints 7 y 8). Pon tu clave solo aquí o en el gestor de secretos; nunca en el código.
# Sin clave, StockSense funciona igual y sin las funciones de IA.
# gemini-3.1-pro-preview no tiene capa gratuita; para gastar menos al probar puedes usar gemini-3.5-flash-lite.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
